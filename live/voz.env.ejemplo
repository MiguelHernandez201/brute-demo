# Copia este archivo como voz.env (en esta misma carpeta) y rellénalo. voz.env no se sube a git: lleva tu clave.

# ElevenLabs: la clave en https://elevenlabs.io/app/settings/api-keys y el ID de la voz en Voices -> (la voz) -> ID.
# Sin estas dos el streamer no habla: solo escribe en la ventana lo que diría (sirve para probar).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opcional. eleven_flash_v2_5 es el más rápido y barato; eleven_multilingual_v2 suena más natural pero tarda más y gasta más.
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Opcional. El modelo de Ollama que responde preguntas (ollama pull qwen2.5:3b). Si tu PC va justa, prueba gemma2:2b.
# OLLAMA_MODEL=qwen2.5:3b
